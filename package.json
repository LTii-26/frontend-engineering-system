{
  "name": "frontend-engineering-system",
  "version": "0.0.0",
  "private": true,
  "description": "一个从零开始构建的前端工程实践项目。",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:staging": "pnpm --filter web build:staging",
    "build:dependencies": "pnpm --filter @frontend-engineering-system/utils build && pnpm --filter @frontend-engineering-system/ui build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "pnpm --filter web preview",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:unit:coverage": "pnpm -r --if-present run test:unit:coverage",
    "test:component": "pnpm -r --if-present run test:component",
    "test:integration": "pnpm -r --if-present run test:integration",
    "dev:e2e": "pnpm --filter @frontend-engineering-system/ui build && pnpm --filter web dev --host 127.0.0.1 --port 4173 --strictPort --mode e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check": "pnpm build:dependencies && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:component && pnpm test:integration && pnpm build",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5"
  }
}
